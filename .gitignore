zig-out/
zig-cache/
.zig-cache/
*.o
*.a
*.so
*.dylib
.DS_Store
firebase-debug.log
CLAUDE.md
.env
*.key
*.pem

# vendor checkouts are script-managed (scripts/build-llama-cpp-macos.sh)
vendor/*
# ...except zortui, which is a committed plain copy (see vendor/zortui/VENDORED.md)
!vendor/zortui/

# prebuilt kernel binaries ARE checked in (exceptions to the rules above).
# Binary redistribution is permitted; dep source stays closed in the
# private sibling repos. Synced by scripts/sync-prebuilts.sh.
!prebuilt/**/*.a
!prebuilt/**/*.so
!prebuilt/**/*.dll
!prebuilt/**/*.dylib
!prebuilt/**/*.metallib
